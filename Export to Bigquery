SAMPLE_CHECK_LIMIT = 50

# Pemetaan Bulan Indonesia ke Inggris
BULAN_ID_TO_EN = {
    'januari': 'january', 'jan': 'jan',
    'februari': 'february', 'feb': 'feb',
    'maret': 'march', 'mar': 'mar',
    'april': 'april', 'apr': 'apr',
    'mei': 'may',
    'juni': 'june', 'jun': 'jun',
    'juli': 'july', 'jul': 'jul',
    'agustus': 'august', 'agu': 'aug', 'ags': 'aug',
    'september': 'september', 'sep': 'sep',
    'oktober': 'october', 'okt': 'oct',
    'november': 'november', 'nov': 'nov',
    'desember': 'december', 'des': 'dec'
}


def buat_credentials():
    scopes = [
        "https://www.googleapis.com/auth/bigquery",
        "https://www.googleapis.com/auth/drive",
        "https://www.googleapis.com/auth/spreadsheets.readonly",
    ]
    if "GCP_SERVICE_ACCOUNT" in os.environ:
        info = json.loads(os.environ["GCP_SERVICE_ACCOUNT"])
        if "private_key" in info:
            info["private_key"] = info["private_key"].replace("\\n", "\n")
        return service_account.Credentials.from_service_account_info(info, scopes=scopes)
    
    path_kunci_lokal = os.path.join(os.path.dirname(__file__), "kunci-bg.json")
    return service_account.Credentials.from_service_account_file(path_kunci_lokal, scopes=scopes)


def ambil_data_gsheet_dengan_retry(creds, gsheet_url, sheet_name, range_name, max_retries=5):
    for attempt in range(1, max_retries + 1):
        try:
            gc = gspread.authorize(creds)
            sh = gc.open_by_url(gsheet_url)
            ws = sh.worksheet(sheet_name)
            return ws.get(range_name)
        except Exception as e:
            if "503" in str(e) or isinstance(e, (ServiceUnavailable, gspread.exceptions.APIError)):
                if attempt == max_retries:
                    raise e
                jeda = 2 ** attempt
                print(f"   ⚠️ Google API 503/Error. Mencoba ulang dalam {jeda} detik... ({attempt}/{max_retries})")
                time.sleep(jeda)
            else:
                raise e


def normalisasi_bulan_indo(val_str):
    val_lower = val_str.lower()
    for id_name, en_name in BULAN_ID_TO_EN.items():
        val_lower = re.sub(rf'\b{id_name}\b', en_name, val_lower)
    return val_lower


def evaluasi_nilai_tunggal(val_str):
    if not val_str:
        return None

    val_str_norm = normalisasi_bulan_indo(val_str)

    # 1. TIMESTAMP
    fmt_datetime = [
        "%d-%b-%Y %H:%M:%S", "%d-%b-%Y %H:%M", "%Y-%m-%d %H:%M:%S",
        "%d/%m/%Y %H:%M:%S", "%m/%d/%Y %H:%M:%S", "%Y-%m-%d %H:%M:%S.%f",
        "%d %B %Y %H:%M:%S", "%d %B %Y %H:%M"
    ]
    for fmt in fmt_datetime:
        try:
            datetime.strptime(val_str_norm, fmt)
            return "TIMESTAMP"
        except ValueError:
            pass

    # 2. DATE
    fmt_date = [
        "%Y-%m-%d", "%d-%b-%Y", "%d/%m/%Y", "%m/%d/%Y",
        "%d %b %Y", "%d %B %Y", "%d-%B-%Y"
    ]
    for fmt in fmt_date:
        try:
            datetime.strptime(val_str_norm, fmt)
            return "DATE"
        except ValueError:
            pass

    # 3. Angka
    if val_str.isdigit():
        return "INTEGER"
    
    try:
        float(val_str)
        return "FLOAT"
    except ValueError:
        pass

    return "STRING"


def tebak_tipe_kolom(sampel_banyak_nilai, nama_kolom):
    if any(k in nama_kolom.lower() for k in ['id', 'code', 'kode', 'phone', 'hp', 'nis', 'nik']):
        return "STRING"

    tipe_terdeteksi = set()
    for val in sampel_banyak_nilai:
        val_str = str(val).strip() if val is not None else ""
        if not val_str:
            continue
        kandidat = evaluasi_nilai_tunggal(val_str)
        if kandidat:
            tipe_terdeteksi.add(kandidat)

    if not tipe_terdeteksi:
        return "STRING"

    if "STRING" in tipe_terdeteksi or len(tipe_terdeteksi) > 1:
        if tipe_terdeteksi == {"INTEGER", "FLOAT"}:
            return "FLOAT"
        return "STRING"

    return tipe_terdeteksi.pop()


def buat_satu_tabel_native(client, creds, table_name, gsheet_url, sheet_name, range_name):
    clean_table_name = re.sub(r'[^a-zA-Z0-9_]', '_', str(table_name).strip())
    clean_table_name = re.sub(r'_+', '_', clean_table_name).strip('_')
    
    table_id = f"{BQ_PROJECT}.{BQ_DATASET}.{clean_table_name}"

    bq_retry = Retry(
        initial=2.0,
        maximum=30.0,
        multiplier=2.0,
        deadline=300.0
    )

    range_data = ambil_data_gsheet_dengan_retry(creds, gsheet_url, sheet_name, range_name)
    if not range_data or len(range_data) <= 1:
        print(f"   SKIP: Range '{range_name}' kosong!\n")
        return

    header_row = range_data[0]
    data_rows_raw = range_data[1:]

    data_rows_clean = [row for row in data_rows_raw if any(str(cell).strip() != "" for cell in row)]
    
    # 1. Susun Schema BigQuery & Nama Kolom
    schema = []
    clean_columns = []
    seen_names = set()

    for idx, col in enumerate(header_row, start=1):
        nama_kolom = str(col).strip()
        clean_col = re.sub(r'[^a-zA-Z0-9_]', '_', nama_kolom) if nama_kolom else f"empty_col_{idx}"
        clean_col = re.sub(r'_+', '_', clean_col).strip('_')
        
        if clean_col and clean_col[0].isdigit():
            clean_col = f"col_{clean_col}"
        if not clean_col:
            clean_col = f"empty_col_{idx}"

        original_clean = clean_col
        counter = 1
        while clean_col in seen_names:
            clean_col = f"{original_clean}_{counter}"
            counter += 1
            
        seen_names.add(clean_col)
        clean_columns.append(clean_col)

        sampel_kolom = [row[idx - 1] for row in data_rows_clean[:SAMPLE_CHECK_LIMIT] if len(row) >= idx]
        data_type = tebak_tipe_kolom(sampel_kolom, clean_col)
        
        schema.append(bigquery.SchemaField(clean_col, data_type))

    # 2. Susun DataFrame Pandas
    df = pd.DataFrame(data_rows_clean, columns=clean_columns)
    df = df.replace(r'^\s*$', None, regex=True)

    # 3. Format Isi DataFrame sesuai Schema
    for field in schema:
        col = field.name
        b_type = field.field_type
        
        if b_type in ["TIMESTAMP", "DATE"]:
            col_series = df[col].astype(str)
            for id_name, en_name in BULAN_ID_TO_EN.items():
                col_series = col_series.str.replace(rf'\b{id_name}\b', en_name, case=False, regex=True)
            
            # Penggunaan format='mixed' untuk menghilangkan UserWarning
            parsed_dt = pd.to_datetime(col_series, errors='coerce', format='mixed')
            
            if b_type == "TIMESTAMP":
                df[col] = parsed_dt
            else:
                df[col] = parsed_dt.dt.date
                
        elif b_type == "INTEGER":
            df[col] = pd.to_numeric(df[col], errors='coerce').astype('Int64')
        elif b_type == "FLOAT":
            df[col] = pd.to_numeric(df[col], errors='coerce').astype('float64')
        else:
            df[col] = df[col].astype(str).replace(["None", "<NA>", "nan"], None)

    # 4. HAPUS TABEL LAMA (Atur retry di parameter fungsi)
    print(f"   [1/3] Menghapus tabel lama '{clean_table_name}' jika ada...")
    client.delete_table(table_id, not_found_ok=True, retry=bq_retry)

    # 5. UPLOAD DATA (Atur retry di dalam job_config)
    job_config = bigquery.LoadJobConfig(
        write_disposition="WRITE_TRUNCATE",
        schema=schema,
        autodetect=False,
        retry=bq_retry  # 👈 DITARUH DI SINI BUKAN DI load_table_from_dataframe
    )
    print(f"   [2/3] Membuat ulang tabel '{clean_table_name}' & mengunggah data...")
    
    job = client.load_table_from_dataframe(
        df, 
        table_id, 
        job_config=job_config
    )
    job.result()

    # 6. ATUR EXPIRATION +60 HARI
    print(f"   [3/3] Mengatur tanggal kadaluarsa (+60 hari)...")
    dest_tbl = client.get_table(table_id, retry=bq_retry)
    dest_tbl.expires = datetime.utcnow() + timedelta(days=60)
    client.update_table(dest_tbl, ["expires"], retry=bq_retry)

    print(f"   BERHASIL! Tabel '{clean_table_name}' dibuat ulang ({len(df)} baris data)!\n")


def baca_config_sheet(creds):
    gc = gspread.authorize(creds)
    ws = gc.open_by_url(CONFIG_SHEET_URL).worksheet(CONFIG_TAB_NAME)
    semua = ws.get_all_records()

    bersih = []
    for baris in semua:
        table_name = str(baris.get("table_name", "")).strip()
        if not table_name:
            continue

        bersih.append({
            "table_name": table_name,
            "gsheet_url": str(baris.get("gsheet_url", "")).strip(),
            "sheet_name": str(baris.get("sheet_name", "")).strip(),
            "range_name": str(baris.get("range_name", "")).strip() or DEFAULT_RANGE,
        })

    print(f"Ditemukan {len(bersih)} tabel yang akan diproses.\n")
    return bersih


def jalankan_semua():
    print("=" * 60)
    print(f"     ROBOT NATIVE TABLE BIGQUERY ({SCRIPT_VERSION})")
    print("=" * 60 + "\n")

    creds  = buat_credentials()
    client = bigquery.Client(credentials=creds, project=BQ_PROJECT)
    daftar_tabel = baca_config_sheet(creds)

    berhasil = 0
    gagal    = 0

    for nomor, baris in enumerate(daftar_tabel, start=1):
        print(f"[{nomor}/{len(daftar_tabel)}] Memproses '{baris['table_name']}'...")
        try:
            buat_satu_tabel_native(
                client, creds, baris["table_name"],
                baris["gsheet_url"], baris["sheet_name"], baris["range_name"]
            )
            berhasil += 1
        except Exception as e:
            print(f"   GAGAL: {e}\n")
            gagal += 1

    print("=" * 60)
    print(f"     SELESAI! Berhasil: {berhasil} | Gagal: {gagal}")
    print("=" * 60)


if __name__ == "__main__":
    jalankan_semua()
