import os
import re
import json
import time
import random
import pandas as pd
import gspread
from google.oauth2 import service_account
from google.cloud import bigquery

SCRIPT_VERSION = "v12.9.1-smart-autodetect"

CONFIG_SHEET_URL = "https://docs.google.com/spreadsheets/d/1y_Z8GO2nrUFVwUv-_PnTgJL3NKQwu7koNNtfh1VRaEY"
CONFIG_TAB_NAME  = "config"
BQ_PROJECT     = "backup-444202"
BQ_DATASET     = "DataLabReady"


def buat_credentials():
    scopes = [
        "https://www.googleapis.com/auth/bigquery",
        "https://www.googleapis.com/auth/drive",
        "https://www.googleapis.com/auth/spreadsheets.readonly",
    ]
    if "GCP_SERVICE_ACCOUNT" in os.environ:
        info = json.loads(os.environ["GCP_SERVICE_ACCOUNT"])
        if "private_key" in info:
            info["private_key"] = info["private_key"].replace("\\n", "\n")
        return service_account.Credentials.from_service_account_info(info, scopes=scopes)
    
    path_kunci_lokal = os.path.join(os.path.dirname(__file__), "kunci-bg.json")
    return service_account.Credentials.from_service_account_file(path_kunci_lokal, scopes=scopes)


def buat_satu_tabel_native(client, creds, table_name, gsheet_url, sheet_name, range_name=None):
    clean_table_name = re.sub(r'[^a-zA-Z0-9_]', '_', str(table_name).strip()).strip('_')
    table_id = f"{BQ_PROJECT}.{BQ_DATASET}.{clean_table_name}"

    gc = gspread.authorize(creds)

    # 1. Ambil Data Berdasarkan Range
    rows = None
    max_retries = 5
    for attempt in range(1, max_retries + 1):
        try:
            sh = gc.open_by_url(gsheet_url)
            ws = sh.worksheet(sheet_name)
            
            if range_name and str(range_name).strip():
                rows = ws.get(str(range_name).strip())
            else:
                rows = ws.get_all_values()
            break
        except Exception as e:
            err_msg = str(e)
            if ("503" in err_msg or "429" in err_msg or "Quota" in err_msg or "unavailable" in err_msg.lower()) and attempt < max_retries:
                sleep_time = (2 ** attempt) + random.uniform(1, 2)
                time.sleep(sleep_time)
            else:
                raise e

    if not rows or len(rows) < 2:
        print(f"    SKIP: Sheet '{sheet_name}' (Range: {range_name}) kosong!\n")
        return

    # 2. Header Sanitization
    raw_headers = rows[0]
    data_rows = rows[1:]

    clean_headers = []
    seen_cols = {}
    for idx, col in enumerate(raw_headers):
        c_clean = re.sub(r'[^a-zA-Z0-9_]', '_', str(col).strip()).strip('_')
        if not c_clean or c_clean[0].isdigit():
            c_clean = f"col_{idx+1}"
        
        if c_clean in seen_cols:
            seen_cols[c_clean] += 1
            c_clean = f"{c_clean}_{seen_cols[c_clean]}"
        else:
            seen_cols[c_clean] = 0
            
        clean_headers.append(c_clean)

    # 3. DataFrame Setup Tanpa Parsing Manual
    df = pd.DataFrame(data_rows, columns=clean_headers)
    
    # Ubah spasi murni/string kosong jadi None (NULL di BigQuery)
    df.replace(r'^\s*$', None, regex=True, inplace=True)
    df.dropna(how='all', inplace=True)

    # Antisipasi objek terstruktur (dict/list) kotor agar PyArrow tidak crash
    for col in df.columns:
        df[col] = df[col].apply(lambda x: json.dumps(x) if isinstance(x, (dict, list)) else x)

    # 4. Overwrite & Serahkan Inferensi Tipe Data ke BigQuery
    job_config = bigquery.LoadJobConfig(
        write_disposition="WRITE_TRUNCATE",
        autodetect=True
    )
    
    job = client.load_table_from_dataframe(df, table_id, job_config=job_config)
    job.result()

    print(f"   BERHASIL! Table '{clean_table_name}' diperbarui dengan Tipe Data Bawaan!\n")
    time.sleep(1.2)


def baca_config_sheet(creds):
    gc = gspread.authorize(creds)
    rows = []
    
    max_retries = 5
    for attempt in range(1, max_retries + 1):
        try:
            ws = gc.open_by_url(CONFIG_SHEET_URL).worksheet(CONFIG_TAB_NAME)
            rows = ws.get_all_values()
            break
        except Exception as e:
            err_msg = str(e)
            if ("503" in err_msg or "429" in err_msg or "Quota" in err_msg) and attempt < max_retries:
                sleep_time = (2 ** attempt) + random.uniform(1, 2)
                time.sleep(sleep_time)
            else:
                raise e

    if not rows or len(rows) < 2:
        return []

    headers = [str(h).strip().lower() for h in rows[0]]
    bersih = []
    
    for row in rows[1:]:
        row_dict = dict(zip(headers, row))
        t_name = str(row_dict.get("table_name", "")).strip()
        if t_name:
            bersih.append({
                "table_name": t_name,
                "gsheet_url": str(row_dict.get("gsheet_url", "")).strip(),
                "sheet_name": str(row_dict.get("sheet_name", "")).strip(),
                "range_name": str(row_dict.get("range_name", row_dict.get("range", ""))).strip(),
            })

    print(f"Ditemukan {len(bersih)} tabel yang akan diproses.\n")
    return bersih


def jalankan_semua():
    print("=" * 60)
    print(f"     ROBOT NATIVE TABLE BIGQUERY ({SCRIPT_VERSION})")
    print("=" * 60 + "\n")

    creds  = buat_credentials()
    client = bigquery.Client(credentials=creds, project=BQ_PROJECT)
    daftar_tabel = baca_config_sheet(creds)

    berhasil, gagal = 0, 0

    for nomor, baris in enumerate(daftar_tabel, start=1):
        print(f"[{nomor}/{len(daftar_tabel)}] Memproses '{baris['table_name']}' (Range: {baris.get('range_name') or 'ALL'})...")
        try:
            buat_satu_tabel_native(
                client, creds, baris["table_name"],
                baris["gsheet_url"], baris["sheet_name"],
                baris.get("range_name")
            )
            berhasil += 1
        except Exception as e:
            print(f"    GAGAL: {e}\n")
            gagal += 1

    print("=" * 60)
    print(f"     SELESAI! Berhasil: {berhasil} | Gagal: {gagal}")
    print("=" * 60)


if __name__ == "__main__":
    jalankan_semua()
